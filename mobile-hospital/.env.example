# Spring API base URL (no trailing slash).
# Local: http://localhost:8080  |  Phone on Wi-Fi: http://<your-PC-LAN-IP>:8080
# oshucare Cloud Run: https://backend-hospital-yspwmymsgq-el.a.run.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Video: must match backend APP_VIDEO_PROVIDER (production uses agora)
EXPO_PUBLIC_VIDEO_PROVIDER=agora

# Google OAuth — replace placeholders with real client IDs from Google Cloud Console.
# Same Web client ID as frontend-hospital VITE_GOOGLE_OAUTH_CLIENT_ID; add Android/iOS clients for release APK.
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

## 5. Agastya Dashboard Integration Points

### 5a. Patient Dashboard — Device Panel

Add a `<DevicePanel>` component to the patient appointment card (alongside Video Call, Edit, Delete, Download Prescription).

```tsx
// components/patient/DevicePanel.tsx

import { useBluetoothDevice } from "@/hooks/useBluetoothDevice";
import { DEVICE_REGISTRY } from "@/lib/bluetooth/deviceRegistry";
import { saveReadingToAppointment } from "@/api/appointments";
import { BluetoothUnsupportedBanner } from "./BluetoothUnsupportedBanner";

interface DevicePanelProps {
  appointmentId: string;
  patientId: string;
}

export function DevicePanel({ appointmentId, patientId }: DevicePanelProps) {
  const [selectedDeviceKey, setSelectedDeviceKey] = useState("GENERIC_SPIROMETER");

  const { status, latestReading, readings, error, isSupported, connect, read, disconnect } =
    useBluetoothDevice({
      appointmentId,
      patientId,
      onReading: async (reading) => {
        // Auto-save to appointment record on each new reading
        await saveReadingToAppointment(appointmentId, reading);
      },
    });

  if (!isSupported) return <BluetoothUnsupportedBanner />;

  return (
    <div className="agastya-device-panel">
      {/* Device Selector */}
      <select
        value={selectedDeviceKey}
        onChange={(e) => setSelectedDeviceKey(e.target.value)}
        disabled={status === "connected"}
      >
        {Object.entries(DEVICE_REGISTRY).map(([key, profile]) => (
          <option key={key} value={key}>
            {profile.icon} {profile.label}
          </option>
        ))}
      </select>

      {/* Patient Instruction */}
      {status === "idle" && (
        <p className="instruction">
          {DEVICE_REGISTRY[selectedDeviceKey].requiresUserAction}
        </p>
      )}

      {/* Connect/Disconnect Button — onClick is REQUIRED for Web Bluetooth */}
      {status !== "connected" ? (
        <button
          onClick={() => connect(selectedDeviceKey)} // ← Must be user gesture
          disabled={status === "connecting"}
          className="btn-connect"
        >
          {status === "connecting" ? "Connecting..." : "🔵 Connect Device"}
        </button>
      ) : (
        <>
          <button onClick={read} className="btn-read">
            📡 Take Reading
          </button>
          <button onClick={disconnect} className="btn-disconnect">
            Disconnect
          </button>
        </>
      )}

      {/* Error */}
      {error && <p className="error-text">{error}</p>}

      {/* Latest Reading */}
      {latestReading && <ReadingDisplay reading={latestReading} />}

      {/* Reading History */}
      {readings.length > 1 && <ReadingHistory readings={readings} />}
    </div>
  );
}
```

### 5b. Doctor Dashboard — View Readings on Appointment

Doctors see all stored readings per appointment alongside prescription upload.

```tsx
// components/doctor/AppointmentReadings.tsx

import { useEffect, useState } from "react";
import { getReadingsForAppointment } from "@/api/appointments";
import { BluetoothReading } from "@/lib/bluetooth/bluetoothService";

export function AppointmentReadings({ appointmentId }: { appointmentId: string }) {
  const [readings, setReadings] = useState<BluetoothReading[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    getReadingsForAppointment(appointmentId)
      .then(setReadings)
      .finally(() => setLoading(false));
  }, [appointmentId]);

  if (loading) return <p>Loading device readings...</p>;
  if (!readings.length) return <p>No device readings recorded for this appointment.</p>;

  return (
    <div className="appointment-readings">
      <h3>Device Readings</h3>
      {readings.map((r, i) => (
        <div key={i} className="reading-card">
          <span className="device-label">{r.deviceName}</span>
          <span className="timestamp">{new Date(r.timestamp).toLocaleString()}</span>
          <div className="measurements">
            {Object.entries(r.measurements).map(([key, val]) => (
              <div key={key}>
                <strong>{key.replace(/_/g, " ").toUpperCase()}</strong>: {val ?? "—"}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  );
}
```


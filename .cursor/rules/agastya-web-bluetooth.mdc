## 7. Unsupported Browser Fallback

Always render a helpful message for Safari/Firefox users — never silently fail.

```tsx
// components/patient/BluetoothUnsupportedBanner.tsx

import { getBluetoothUnsupportedReason } from "@/lib/bluetooth/bluetoothSupport";

export function BluetoothUnsupportedBanner() {
  return (
    <div className="bluetooth-unsupported">
      <span>📵</span>
      <div>
        <strong>Device Connection Unavailable</strong>
        <p>{getBluetoothUnsupportedReason()}</p>
        <p>
          For the best experience with medical device integration, please use{" "}
          <strong>Chrome on Android</strong> or <strong>Chrome/Edge on Desktop</strong>.
        </p>
      </div>
    </div>
  );
}

## 4. React Hook — `useBluetoothDevice`

Use this hook in all components. Never use the service directly in components.

```typescript
// hooks/useBluetoothDevice.ts

import { useState, useCallback, useRef } from "react";
import {
  connectDevice,
  disconnectDevice,
  readMeasurement,
  subscribeToNotifications,
  BluetoothReading,
  BluetoothSession,
} from "@/lib/bluetooth/bluetoothService";
import { isWebBluetoothSupported, getBluetoothUnsupportedReason } from "@/lib/bluetooth/bluetoothSupport";

export type BluetoothStatus =
  | "idle"
  | "connecting"
  | "connected"
  | "reading"
  | "error"
  | "unsupported"
  | "disconnected";

interface UseBluetoothDeviceOptions {
  appointmentId?: string;
  patientId?: string;
  onReading?: (reading: BluetoothReading) => void;
  autoSubscribe?: boolean; // If true, start notifications on connect
}

export function useBluetoothDevice(options: UseBluetoothDeviceOptions = {}) {
  const [status, setStatus] = useState<BluetoothStatus>(
    isWebBluetoothSupported() ? "idle" : "unsupported"
  );
  const [session, setSession] = useState<BluetoothSession | null>(null);
  const [latestReading, setLatestReading] = useState<BluetoothReading | null>(null);
  const [readings, setReadings] = useState<BluetoothReading[]>([]);
  const [error, setError] = useState<string | null>(null);
  const unsubscribeRef = useRef<(() => void) | null>(null);

  const context = {
    appointmentId: options.appointmentId,
    patientId: options.patientId,
  };

  const connect = useCallback(
    async (deviceKey: string) => {
      if (!isWebBluetoothSupported()) {
        setStatus("unsupported");
        setError(getBluetoothUnsupportedReason());
        return;
      }

      setStatus("connecting");
      setError(null);

      try {
        const newSession = await connectDevice(deviceKey);
        setSession(newSession);
        setStatus("connected");

        if (options.autoSubscribe) {
          const unsubscribe = await subscribeToNotifications(
            newSession,
            (reading) => {
              setLatestReading(reading);
              setReadings((prev) => [reading, ...prev].slice(0, 50)); // Keep last 50
              options.onReading?.(reading);
            },
            context
          );
          unsubscribeRef.current = unsubscribe;
        }
      } catch (err: any) {
        // User cancelled the device picker — don't show as error
        if (err.name === "NotFoundError") {
          setStatus("idle");
        } else {
          setStatus("error");
          setError(err.message ?? "Failed to connect to device");
        }
      }
    },
    [options.autoSubscribe, options.appointmentId, options.patientId]
  );

  const read = useCallback(async () => {
    if (!session) return;
    setStatus("reading");
    try {
      const reading = await readMeasurement(session, context);
      setLatestReading(reading);
      setReadings((prev) => [reading, ...prev].slice(0, 50));
      options.onReading?.(reading);
      setStatus("connected");
      return reading;
    } catch (err: any) {
      setStatus("error");
      setError(err.message ?? "Failed to read from device");
    }
  }, [session, options.appointmentId, options.patientId]);

  const disconnect = useCallback(async () => {
    unsubscribeRef.current?.();
    unsubscribeRef.current = null;
    await disconnectDevice();
    setSession(null);
    setStatus("disconnected");
  }, []);

  const reset = useCallback(() => {
    setStatus(isWebBluetoothSupported() ? "idle" : "unsupported");
    setError(null);
    setLatestReading(null);
    setReadings([]);
  }, []);

  return {
    status,
    session,
    latestReading,
    readings,
    error,
    isSupported: isWebBluetoothSupported(),
    isConnected: status === "connected" || status === "reading",
    connect,     // Must be called from onClick — never from useEffect
    read,
    disconnect,
    reset,
  };
}
```


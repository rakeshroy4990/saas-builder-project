## 6. Backend API — Storing Readings

Add these endpoints to your existing appointment API.

```typescript
// api/appointments.ts (additions)

import { BluetoothReading } from "@/lib/bluetooth/bluetoothService";

// POST /api/appointments/:id/readings
export async function saveReadingToAppointment(
  appointmentId: string,
  reading: BluetoothReading
): Promise<void> {
  const token = localStorage.getItem("jwt_token"); // Use your existing JWT approach
  await fetch(`/api/appointments/${appointmentId}/readings`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${token}`,
    },
    body: JSON.stringify(reading),
  });
}

// GET /api/appointments/:id/readings
export async function getReadingsForAppointment(
  appointmentId: string
): Promise<BluetoothReading[]> {
  const token = localStorage.getItem("jwt_token");
  const res = await fetch(`/api/appointments/${appointmentId}/readings`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (!res.ok) return [];
  return res.json();
}
```

**Backend DB Schema (add to your appointments model):**

```sql
CREATE TABLE appointment_device_readings (
  id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  appointment_id UUID NOT NULL REFERENCES appointments(id) ON DELETE CASCADE,
  patient_id    UUID NOT NULL REFERENCES users(id),
  device_key    VARCHAR(64) NOT NULL,
  device_name   VARCHAR(128),
  device_type   VARCHAR(32) NOT NULL,
  measurements  JSONB NOT NULL,        -- e.g. {"fev1": 2.8, "fvc": 3.5, "pef": 420}
  raw_bytes     BYTEA,                 -- Optional raw BLE bytes for audit
  recorded_at   TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  created_at    TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_readings_appointment ON appointment_device_readings(appointment_id);
CREATE INDEX idx_readings_patient ON appointment_device_readings(patient_id);
```


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agastya.dev/schemas/static-config.json",
  "title": "StaticConfig",
  "type": "object",
  "required": ["app", "brand", "flags", "seo"],
  "properties": {
    "tenantId": { "type": ["string", "null"] },
    "app": {
      "type": "object",
      "required": ["name", "logoUrl"],
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "logoUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "supportEmail": { "type": "string" }
      }
    },
    "brand": {
      "type": "object",
      "required": ["colors", "fonts", "fontSizes"],
      "properties": {
        "colors": { "type": "object", "additionalProperties": { "type": "string" } },
        "fonts": { "type": "object", "additionalProperties": { "type": "string" } },
        "fontSizes": { "type": "object", "additionalProperties": { "type": "string" } },
        "borderRadius": { "type": "string" },
        "shadowStyle": { "enum": ["soft", "sharp", "none"] }
      }
    },
    "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "seo": {
      "type": "object",
      "properties": {
        "defaultTitle": { "type": "string" },
        "defaultDescription": { "type": "string" },
        "ogImage": { "type": "string" }
      }
    }
  }
}
